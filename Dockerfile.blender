# Headless Blender 4.x for GLB -> FBX conversion.
#
# Ubuntu 24.04 (noble) ships Blender 4.0.2, which supports the glTF import
# and FBX export (with embedded textures) used by scripts/glb_to_fbx.py.
# This conversion is pure CPU work, so it runs fine on Apple Silicon.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        blender python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# docker-compose.yml bind-mounts this repo's scripts/ read-only at /scripts.
WORKDIR /work
# --python-use-system-env: the glTF addon needs numpy from the system Python.
ENTRYPOINT ["blender", "--python-use-system-env"]
